{
  "name": "tomeva-admin",
  "version": "1.0.0",
  "description": "Tomeva Admin - Library Dashboard (Electron desktop app)",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:oauth": "node --test test/oauth-flow.test.js",
    "build:win": "electron-builder --config electron-builder.config.cjs --win",
    "build:mac": "electron-builder --config electron-builder.config.cjs --mac",
    "build:linux": "electron-builder --config electron-builder.config.cjs --linux"
  },
  "devDependencies": {
    "electron": "^43.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.tomeva.admin",
    "productName": "Tomeva Admin",
    "protocols": [
      {
        "name": "Tomeva Admin updates",
        "schemes": [
          "tomeva-admin"
        ]
      }
    ],
    "files": [
      "main.js",
      "oauth-flow.js",
      "preload.js",
      "index.html",
      "kiosk-management.js",
      "assets/**",
      {
        "from": "../desktop-integration",
        "to": "integration",
        "filter": [
          "*.cjs"
        ]
      },
      {
        "from": "../Control Center/desktop-releases.js",
        "to": "release-discovery.js"
      },
      "public-releases.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
