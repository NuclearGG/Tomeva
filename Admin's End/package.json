{
  "name": "tomeva-admin",
  "version": "1.0.6",
  "description": "Tomeva Admin - Library Dashboard (Electron desktop app)",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test:staff": "node --test test/staff-access.test.js",
    "test:roster": "node --test test/roster-import.test.mjs",
    "test:releases": "node --test test/release-discovery.test.cjs",
    "start": "electron .",
    "test:oauth": "node --test test/oauth-flow.test.js",
    "build:win": "electron-builder --config electron-builder.config.cjs --win",
    "build:mac": "electron-builder --config electron-builder.config.cjs --mac",
    "build:linux": "electron-builder --config electron-builder.config.cjs --linux",
    "test:desktop": "electron test/desktop-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-fetch": "2.7.0"
  },
  "build": {
    "appId": "com.tomeva.admin",
    "productName": "Tomeva Admin",
    "protocols": [
      {
        "name": "Tomeva Admin updates",
        "schemes": [
          "tomeva-admin"
        ]
      }
    ],
    "files": [
      "main.js",
      "oauth-flow.js",
      "preload.js",
      "index.html",
      "kiosk-management.js",
      "roster-import.mjs",
      "release-discovery.js",
      "build-variant.json",
      "assets/**",
      {
        "from": "../desktop-integration",
        "to": "integration",
        "filter": [
          "*.cjs"
        ]
      },
      "public-releases.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "artifactName": "tomeva-admin-${version}-${os}-${arch}.${ext}"
  }
}
